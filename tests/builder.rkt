#lang racket/base

;; The build system's tests: a project is read, its sources are rendered, and
;; the files a build writes are looked at.  The last test builds a program
;; with pyinstaller, which needs a venv and a download; it runs only when
;; RKT_PYTHONIZE_BUILD_TEST is set.

(require rackunit
         racket/file
         racket/port
         racket/list
         racket/path
         racket/string
         racket/system
         "../builder/project.rkt"
         "../builder/render.rkt"
         "../builder.rkt")

(define created (box '()))

;; a project in the system's temporary directory: a test makes a venv and an
;; executable, and nothing of that belongs in the repository
(define (tmp-dir)
  (define dir (make-temporary-file "rkt-pythonize-builder-~a" 'directory))
  (set-box! created (cons dir (unbox created)))
  dir)

(define (dir-name dir)
  (define text (path->string (simplify-path (path->complete-path dir))))
  (define trimmed (regexp-replace #rx"[/\\\\]+$" text ""))
  (define match (regexp-match #rx"([^/\\\\]+)$" trimmed))
  (and match (cadr match)))

(define (write-file path text)
  (make-directory* (path-only path))
  (display-to-file text path #:exists 'replace))

;; a source file of the program: a module that renders the body, with the
;; prelude's prefix pinned so the Python reads the same every time
(define (python-module body)
  (string-append
   "#lang racket/base\n"
   "(require rkt-pythonize)\n"
   "(begin-for-syntax (prelude-prefix \"\"))\n"
   "(define python\n"
   "  (#%python-code\n"
   body "\n"
   "))\n"
   "(provide python)\n"))

(define (simple-project)
  (define dir (tmp-dir))
  (write-file (build-path dir "src/main.rkt") (python-module "    (print \"hi\")"))
  (write-file (build-path dir "src/util.rkt") (python-module "    (define (twice x) (* x 2))"))
  (write-file (build-path dir "src/helper.py")
              "def greet(name):\n    return 'hi ' + name\n")
  (write-file (build-path dir "src/net/http.rkt") (python-module "    (define (get url) url)"))
  dir)

(module+ test
  (test-case "a project reads: its name, entry, modules and files"
    (define dir (simple-project))
    (define project (read-project dir))
    (check-equal? (project-name project) (dir-name dir))
    (check-equal? (project-entry project) "main")
    (check-equal? (project-modules project) '("helper" "main" "net.http" "util"))
    (check-equal? (map source-file-relative (project-files project))
                  (list (string->path "helper.py")
                        (string->path "main.rkt")
                        (string->path "net/http.rkt")
                        (string->path "util.rkt")))
    (check-equal? (path->string (project-output-file project (car (project-files project))))
                  (path->string (build-path dir "build/python/helper.py"))))

  (test-case "a .rkt renders to the same path, and a .py is copied"
    (define dir (simple-project))
    (define project (read-project dir))
    (render-project project #:quiet? #t)
    (check-equal? (file->string (build-path dir "build/python/main.py"))
                  "# generated by rkt-pythonize\n\nprint(\"hi\")\n")
    (check-equal? (file->string (build-path dir "build/python/helper.py"))
                  "def greet(name):\n    return 'hi ' + name\n")
    (check-true (file-exists? (build-path dir "build/python/net/http.py")))
    (check-true (file-exists? (build-path dir "build/python/net/__init__.py")))
    ;; the build does not write into the program's own directory
    (check-false (directory-exists? (build-path dir "src/compiled")))
    (check-false (directory-exists? (build-path dir "src/net/compiled"))))

  (test-case "a .rkt that does not provide python is refused"
    (define dir (tmp-dir))
    (write-file (build-path dir "src/main.rkt") "#lang racket/base\n(define x 1)\n")
    (check-exn (lambda (e) (and (exn:fail? e) (regexp-match? #rx"provides python" (exn-message e))))
               (lambda () (render-project (read-project dir) #:quiet? #t))))

  (test-case "a .rkt and a .py of one name are one module twice"
    (define dir (tmp-dir))
    (write-file (build-path dir "src/main.rkt") (python-module "    (print 1)"))
    (write-file (build-path dir "src/main.py") "print(2)\n")
    (check-exn #rx"are both the module main"
               (lambda () (read-project dir))))

  (test-case "a file's name is a module name"
    (define dir (tmp-dir))
    (write-file (build-path dir "src/main.rkt") (python-module "    (print 1)"))
    (write-file (build-path dir "src/my-util.rkt") (python-module "    (print 2)"))
    (check-exn #rx"not a Python name"
               (lambda () (read-project dir))))

  (test-case "the entry is one of the program's modules"
    (define dir (tmp-dir))
    (write-file (build-path dir "src/util.rkt") (python-module "    (print 1)"))
    (check-exn #rx"entry module main"
               (lambda () (read-project dir))))

  (test-case "the build directory cannot be inside the source directory"
    (define dir (tmp-dir))
    (write-file (build-path dir "src/main.rkt") (python-module "    (print 1)"))
    (check-exn #rx"cannot be inside the source directory"
               (lambda () (read-project dir #:dest "src/build"))))

  (test-case "the options name the program, its source directory and its entry"
    (define dir (tmp-dir))
    (write-file (build-path dir "program/net/http.rkt") (python-module "    (print 1)"))
    (define project (read-project dir
                                  #:source "program"
                                  #:dest "out"
                                  #:name "app"
                                  #:entry "net.http"))
    (check-equal? (project-name project) "app")
    (check-equal? (project-entry project) "net.http")
    (check-equal? (project-modules project) '("net.http"))
    (check-equal? (path->string (project-dest project))
                  (path->string (build-path dir "out")))
    (check-equal? (path->string (project-entry-file project))
                  (path->string (build-path dir "out/python/net/http.py"))))

  (test-case "attachments: data/ is read, and #:data adds"
    (define dir (tmp-dir))
    (write-file (build-path dir "src/main.rkt") (python-module "    (print 1)"))
    (write-file (build-path dir "data/hello.txt") "hello\n")
    (write-file (build-path dir "assets/logo.png") "PNG")
    (define project (read-project dir #:data (list (cons "assets" "assets"))))
    (check-equal? (map (lambda (attachment)
                         (cons (path->string (attachment-source attachment))
                               (attachment-dest attachment)))
                       (project-attachments project))
                  (list (cons (path->string (build-path dir "data")) "data")
                        (cons (path->string (build-path dir "assets")) "assets")))
    (check-exn #rx"nothing to attach"
               (lambda () (read-project dir #:data (list (cons "nope" "nope")))))
    (check-exn #rx"not a destination"
               (lambda () (read-project dir #:data (list (cons "data" "../out")))))
    (check-exn #rx"not a destination"
               (lambda () (read-project dir #:data (list (cons "data" "a/../../b")))))
    (check-exn #rx"needs a destination with a name"
               (lambda () (read-project dir #:data (list (cons "data" ".")))))
    (check-exn #rx"both land at data"
               (lambda () (read-project dir #:data (list (cons "assets" "data"))))))

  (test-case "the attachments are copied and the runtime module is written"
    (define dir (tmp-dir))
    (write-file (build-path dir "src/main.rkt") (python-module "    (print 1)"))
    (write-file (build-path dir "data/hello.txt") "hello\n")
    (define project (read-project dir))
    (render-project project #:quiet? #t)
    (check-equal? (file->string (build-path dir "build/data/hello.txt")) "hello\n")
    (define runtime (file->string (build-path dir "build/python/rkt_pythonize_runtime.py")))
    (check-true (string-contains? runtime "def base("))
    (check-true (string-contains? runtime "def path("))
    (check-true (string-contains? runtime "def read("))
    (check-true (string-contains? runtime "def text("))
    (check-true (string-contains? runtime "_MEIPASS")))

  (test-case "the runtime module is the build's, not the program's"
    (define dir (tmp-dir))
    (write-file (build-path dir "src/main.rkt") (python-module "    (print 1)"))
    (write-file (build-path dir "src/rkt_pythonize_runtime.rkt") (python-module "    (print 2)"))
    (check-exn #rx"cannot have one"
               (lambda () (read-project dir))))

  (test-case "a program is built and runs"
    (when (getenv "RKT_PYTHONIZE_BUILD_TEST")
      (define dir (tmp-dir))
      (write-file (build-path dir "data/hello.txt") "hello from the attachment")
      (write-file (build-path dir "src/main.rkt")
                  (python-module
                   (string-append
                    "    (define runtime (import rkt_pythonize_runtime))\n"
                    "    (print ((object-get-attr (import util) \"twice\") 21))\n"
                    "    (print ((object-get-attr runtime \"text\") \"data/hello.txt\"))")))
      (write-file (build-path dir "src/util.rkt") (python-module "    (define (twice x) (* x 2))"))
      (define expected "42\nhello from the attachment\n")
      ;; the rendered program runs from build/python, with the attachments
      ;; written beside it
      (define python (or (find-executable-path "python3") (find-executable-path "python")))
      (render-project (read-project dir) #:quiet? #t)
      (check-equal? (with-output-to-string
                      (lambda ()
                        (system* python
                                 (path->string (build-path dir "build/python/main.py")))))
                    expected)
      ;; and it is packed, with the attachments inside the executable
      (define venv (build-path dir "venv"))
      (define exe (build-executable dir #:venv venv #:name "app" #:quiet? #t))
      (check-true (file-exists? exe))
      (check-equal? (with-output-to-string (lambda () (system* (path->string exe))))
                    expected)
      ;; the other shape: a directory that holds the executable and its
      ;; libraries, built from the venv the first build made
      (define directory (build-executable dir
                                          #:venv venv
                                          #:name "app-dir"
                                          #:onefile? #f
                                          #:quiet? #t))
      (check-true (file-exists? directory))))

  ;; leave nothing behind
  (for ([dir (in-list (unbox created))])
    (with-handlers ([exn:fail? void])
      (delete-directory/files dir))))
