#lang racket/base

;; The DSL: a program is a module that compiles itself, and the executable only
;; writes its python-code out.

(require rackunit
         racket/file
         racket/port
         racket/string
         racket/system)

(define repo
  (path->string (path->complete-path
                 (build-path (or (current-load-relative-directory) (current-directory)) 'up))))
(define collections
  (string-append (path->string (path->complete-path (build-path repo 'up))) ":"))

;; a subprocess, with the collection path pointed at this checkout so that
;; #lang rkt-pythonize resolves here rather than to an installed copy
(define (racket-run expression)
  (define out (open-output-string))
  (define err (open-output-string))
  (define status
    (parameterize ([current-output-port out]
                   [current-error-port err]
                   [current-directory repo])
      (system* (find-executable-path "env") (string-append "PLTCOLLECTS=" collections)
               (find-executable-path "racket") "-e" expression)))
  (values status (get-output-string out) (get-output-string err)))

(define (python-code-of source)
  (define directory (make-temporary-file "rkt-pythonize~a" 'directory))
  (define program (build-path directory "program.rkt"))
  (display-to-file source program #:exists 'replace)
  (define-values (status out err)
    (racket-run (format "(require (file ~s)) (display python-code)" (path->string program))))
  (unless (eq? status #t)
    (fail (format "the module did not compile:\n~a" err)))
  out)

(define (run-python code)
  (define out (open-output-string))
  (define err (open-output-string))
  (define status
    (parameterize ([current-output-port out] [current-error-port err])
      (system* (find-executable-path "python3") "-c" code)))
  (values status (get-output-string out) (get-output-string err)))

(module+ test
  (test-case "a module compiles itself to Python"
    (check-equal?
     (python-code-of
      "#lang rkt-pythonize\n(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))\n(print (fact 5))\n")
     (string-append "# generated by rkt-pythonize\n"
                    "def fact(n):\n"
                    "    return (1 if (n == 0) else (n * fact((n - 1))))\n"
                    "print(fact(5))\n")))

  (test-case "an expression, a definition and an assignment"
    (define-values (status out err)
      (run-python (python-code-of
                   "#lang rkt-pythonize\n(print (+ 1 2))\n(define x 10)\n(set! x (+ x 1))\n(print x)\n")))
    (check-equal? status #t (format "python failed: ~a" err))
    (check-equal? out "3\n11\n"))

  (test-case "a macro is a Racket macro"
    (define-values (status out err)
      (run-python
       (python-code-of
        (string-append "#lang rkt-pythonize\n"
                       "(define-syntax-rule (unless c body) (if c #f body))\n"
                       "(unless #f (print \"ran\"))\n"))))
    (check-equal? status #t (format "python failed: ~a" err))
    (check-equal? out "ran\n"))

  (test-case "lb:raise raises, and no Symbol is involved"
    (define code (python-code-of "#lang rkt-pythonize\n(lb:raise \"boom\")\n"))
    (check-true (string-contains? code "_raise"))
    (check-false (string-contains? code "Symbol"))
    (define-values (status out err) (run-python code))
    (check-not-eq? status #t)
    (check-regexp-match #rx"_Raised" err))

  (test-case "a quote is data, and a symbol in data is refused"
    (define-values (status out err)
      (run-python (python-code-of "#lang rkt-pythonize\n(print (quote (1 \"a\" #t)))\n")))
    (check-equal? status #t (format "python failed: ~a" err))
    (check-equal? out "[1, 'a', True]\n")
    (check-exn exn:fail? (lambda () (python-code-of "#lang rkt-pythonize\n(print (quote a))\n")))))
