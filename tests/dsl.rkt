#lang racket/base

;; #%python-code takes LE and is the Python it renders; these tests render a
;; program, look at the Python, and run it with python3.

(require rackunit
         racket/file
         racket/port
         racket/string
         racket/system
         rkt-pythonize
         "macros.rkt")

;; python3 first, then python, and PYTHON_EXE overrides both
(define (find-python)
  (define candidates
    (if (getenv "PYTHON_EXE")
        (list (getenv "PYTHON_EXE") "python3" "python")
        (list "python3" "python")))
  (or (for/or ([candidate (in-list candidates)])
        (and candidate (find-executable-path candidate)))
      (error 'test "no Python found: set PYTHON_EXE, or put python3 or python on PATH")))

;; a program goes in a file: the command line has its own limit, and a chain a
;; thousand steps long reaches it
(define (program-file)
  (define dir (build-path (current-directory) ".tmp"))
  (make-directory* dir)
  (make-temporary-file "rkt-pythonize-~a.py" #f dir))

(define (run-python code)
  (define out (open-output-string))
  (define err (open-output-string))
  (define file (program-file))
  (call-with-output-file file #:exists 'truncate (lambda (o) (display code o)))
  (define status
    (parameterize ([current-output-port out] [current-error-port err])
      (system* (find-python) (path->string file))))
  (delete-file file)
  (values status (get-output-string out) (get-output-string err)))

;; the macro renders while the module compiles, so a program that has to be
;; refused is expanded at run time here, where the failure can be caught
;; the prelude's names carry a prefix the compiler makes up; a test pins it, so
;; the Python it looks at reads the same every time
(define (pin-prelude!)
  (eval '(begin-for-syntax (prelude-prefix ""))))

(define (python-of-data forms)
  (parameterize ([current-namespace (make-base-namespace)])
    (eval '(require rkt-pythonize))
    (pin-prelude!)
    (eval `(#%python-code ,@forms))))

(define (refuses? forms)
  (with-handlers ([exn:fail? (lambda (e) #t)])
    (python-of-data forms)
    #f))

;; what a program that has to be refused is refused with
(define (refusal-message forms)
  (with-handlers ([exn:fail? (lambda (e) (exn-message e))])
    (python-of-data forms)
    #f))

;; a program whose macros are defined in the namespace it is expanded in: a
;; macro is visible where its name is bound, and an eval'd defmacro binds it
;; there
(define (python-of-data-with defs forms)
  (parameterize ([current-namespace (make-base-namespace)])
    (eval '(require rkt-pythonize))
    (pin-prelude!)
    (for ([d (in-list defs)]) (eval d))
    (eval `(#%python-code ,@forms))))

(define (refusal-message-with defs forms)
  (with-handlers ([exn:fail? (lambda (e) (exn-message e))])
    (python-of-data-with defs forms)
    #f))

;; a program compiled in another style: the style is a parameter of the
;; compiler, so it is set at the phase the compiler runs in, before the form
(define (python-of-data-in-style style forms)
  (parameterize ([current-namespace (make-base-namespace)])
    (eval '(require rkt-pythonize))
    (pin-prelude!)
    (eval `(begin-for-syntax (python-name-style ',style)))
    (eval `(#%python-code ,@forms))))

;; and a test that is about the prefix pins it to something it can read
(define (python-of-data-with-prefix prefix forms)
  (parameterize ([current-namespace (make-base-namespace)])
    (eval '(require rkt-pythonize))
    (eval `(begin-for-syntax (prelude-prefix ,prefix)))
    (eval `(#%python-code ,@forms))))

(define (refusal-message-in-style style forms)
  (with-handlers ([exn:fail? (lambda (e) (exn-message e))])
    (python-of-data-in-style style forms)
    #f))

;; the warnings the compiler logs for a program, which is how a name the
;; program never binds is seen
(define (warnings-of forms [style 'snake])
  (define logger (make-logger))
  (define receiver (make-log-receiver logger 'warning))
  (define messages '())
  (parameterize ([current-logger logger]) (python-of-data-in-style style forms))
  (let loop ()
    (define message (sync/timeout 0.3 receiver))
    (when message
      (set! messages (append messages (list (vector-ref message 1))))
      (loop)))
  (string-join messages " "))

(define (python-output code)
  (define-values (status out err) (run-python code))
  (unless (eq? status #t) (error 'test "python failed: ~a" err))
  out)

(module+ test
  ;; the prelude's prefix is pinned for this module too, so the forms below read
  ;; the Python they expect
  (begin-for-syntax (prelude-prefix ""))

  (test-case "a program renders to Python, and the rendering is a string"
    (define code
      (#%python-code
        (define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))
        (print (fact 5))))
    (check-true (string? code))
    (check-equal? code
                  (string-append "# generated by rkt-pythonize\n"
                                 "\n"
                                 "def fact(n):\n"
                                 "    return (1 if (n == 0) is not False else (n * fact((n - 1))))\n"
                                 "\n"
                                 "print(fact(5))\n"))
    (check-equal? (python-output code) "120\n"))

  (test-case "statements: define, set!, begin and a statement if"
    (check-equal? (python-output
                   (#%python-code
                     (define x 0)
                     (set! x (+ x 1))
                     (begin (set! x (* x 10)) (print x))
                     (if (> x 1) (set! x 0) (set! x 99))
                     (print x)))
                  "10\n0\n"))

  (test-case "a procedure takes several bodies and a rest parameter"
    (check-equal? (python-output
                   (#%python-code
                     (define (biggest first . rest)
                       (print first)
                       (apply max (list first (apply max rest))))
                     (print (biggest 1 2 3))
                     (define (tag a . rest) (list a rest))
                     (print (tag 1 2))))
                  "1\n3\n[1, [2]]\n"))

  (test-case "only #f is false"
    (check-equal? (python-output
                   (#%python-code
                     (print (if 0 "0 is true" "0 is false"))
                     (print (if (quote ()) "() is true" "() is false"))
                     (print (if #f "no" "yes"))))
                  "0 is true\n() is true\nyes\n"))

  (test-case "raise and with-handler"
    (check-equal? (python-output
                   (#%python-code
                     (define (recover e) (+ e 1))
                     (print (with-handler recover (raise 41)))
                     (print (if #f (with-handler recover (raise 1)) 7))))
                  "42\n7\n")
    (define-values (status out err)
      (run-python (#%python-code (raise "boom"))))
    (check-not-eq? status #t)
    (check-regexp-match #rx"Raised" err))

  (test-case "trampoline calls the function the last body returns, and stays flat"
    (check-equal? (python-output
                   (#%python-code
                     (define (count n acc)
                       (if (= n 0) acc (lambda () (count (- n 1) (+ acc 1)))))
                     (print (trampoline (count 100000 0)))))
                  "100000\n"))

  (test-case "a name is converted and carries its runtime piece"
    (define code
      (#%python-code
        (define xs (list 1 2 3))
        (object-set! xs 0 10)
        (print (object-ref xs 0))
        (print (object-has-attr? xs "append"))
        (print xs)))
    (check-true (string-contains? code "object_set_b("))
    (check-true (string-contains? code "object_has_attr_p("))
    (check-equal? (python-output code) "10\nTrue\n[10, 2, 3]\n"))

  (test-case "a with-handler body can be statements"
    (define code
      (#%python-code
        (define (recover e) (+ e 100))
        (define x 0)
        (define (boom)
          (set! x 1)
          (with-handler recover (set! x (+ x 1)) (raise 1)))
        (print (boom))
        (print x)))
    (check-true (string-contains? code "global x"))
    (check-equal? (python-output code) "101\n2\n"))

  (test-case "a trampoline body can be statements"
    (check-equal? (python-output
                   (#%python-code
                     (define (count n)
                       (trampoline
                         (print n)
                         (if (= n 0) "done" (count (- n 1)))))
                     (print (count 2))))
                  "2\n1\n0\ndone\n"))

  (test-case "a trampoline body with a statement hoists a def"
    (define code
      (#%python-code
        (define x 0)
        (define (count n)
          (if (= n 0) x (lambda () (count (- n 1)))))
        (print (trampoline (set! x 1) (count 3)))
        (print x)))
    (check-true (string-contains? code "def _lift"))
    (check-equal? (python-output code) "1\n1\n"))

  (test-case "import is an expression, and the module is a value"
    (check-equal? (python-output
                   (#%python-code
                     (define math (import math))
                     (print ((object-get-attr math "sqrt") 16))
                     (print (object-has-attr? (import "math") "floor"))
                     (print (object-has-attr? (import math) "pi"))))
                  "4.0\nTrue\nTrue\n")
    (check-true (refuses? '((import))))
    (check-true (refuses? '((import math os)))))

  (test-case "a lifted lambda takes what it captures"
    (define code
      (#%python-code
        (define (adder n) (lambda (x) (+ x n)))
        (define add3 (adder 3))
        (print (add3 4))
        (print ((adder 10) 5))))
    (check-true (string-contains? code "def _lift"))
    (check-equal? (python-output code) "7\n15\n"))

  (test-case "a lambda body can be statements"
    (check-equal? (python-output
                   (#%python-code
                     (define (add-twice n)
                       ((lambda (x)
                          (define y (+ x 1))
                          (set! y (+ y n))
                          y)
                        10))
                     (print (add-twice 5))))
                  "16\n"))

  (test-case "a lambda takes a rest parameter"
    (check-equal? (python-output
                   (#%python-code
                     (define f (lambda (a . rest) (list a rest)))
                     (print (f 1 2 3))))
                  "[1, [2, 3]]\n"))

  (test-case "a capturing lambda passes its rest parameter on"
    (check-equal? (python-output
                   (#%python-code
                     (define (tagger n) (lambda (a . rest) (list n a rest)))
                     (print ((tagger 1) 2 3 4))))
                  "[1, 2, [3, 4]]\n"))

  (test-case "a procedure takes keyword parameters, and a call writes them"
    (define code
      (#%python-code
        (define (f a #:k k) (+ a k))
        (print (f 1 #:k 2))
        (print (f #:k 2 1))))
    (check-equal? code
                  (string-append "# generated by rkt-pythonize\n"
                                 "\n"
                                 "def f(a, *, k):\n"
                                 "    return (a + k)\n"
                                 "\n"
                                 "print(f(1, k=2))\n"
                                 "\n"
                                 "print(f(1, k=2))\n"))
    (check-equal? (python-output code) "3\n3\n"))

  (test-case "a keyword name is converted as a name is, on both sides of a call"
    (define code
      (#%python-code
        (define (tag #:even? even?) (if even? "even" "odd"))
        (print (tag #:even? 4))))
    (check-true (string-contains? code "def tag(*, even_p):"))
    (check-true (string-contains? code "tag(even_p=4)"))
    (check-equal? (python-output code) "even\n")
    ;; the call to a Python function converts the keyword it writes the same way
    (define python-call
      (#%python-code
        (define b (bytes (list 1 2 3)))
        (print ((object-get-attr b "hex") "-" #:bytes-per-sep 1))))
    (check-true (string-contains? python-call "bytes_per_sep=1"))
    (check-equal? (python-output python-call) "01-02-03\n"))

  (test-case "a keyword argument reaches a Python function"
    (check-equal? (python-output
                   (#%python-code
                     (print (sorted (list 3 1 2) #:reverse #t))
                     (print (round 2.567 #:ndigits 2))))
                  "[3, 2, 1]\n2.57\n"))

  (test-case "a call may write its keyword arguments where it likes"
    (define code
      (#%python-code
        (define (f a #:k k . rest) (list a k rest))
        (print (f 1 #:k 2 3 4))
        (print (f 1 3 4 #:k 2))))
    (check-true (string-contains? code "def f(a, *rest, k):"))
    (check-true (string-contains? code "rest = [*rest]"))
    (check-true (string-contains? code "print(f(1, 3, 4, k=2))"))
    (check-equal? (python-output code) "[1, 2, [3, 4]]\n[1, 2, [3, 4]]\n"))

  (test-case "a lambda takes keyword parameters, and a lifted one passes them on"
    (define code
      (#%python-code
        (define (adder n) (lambda (x #:k k) (+ x n k)))
        (define add3 (adder 3))
        (print (add3 4 #:k 5))
        (print ((adder 10) 1 #:k 2))))
    (check-true (string-contains? code "def _lift"))
    (check-true (string-contains? code "lambda x, *, k: _lift"))
    (check-equal? (python-output code) "12\n13\n"))

  (test-case "a capturing procedure with a rest parameter spreads keywords too"
    (define code
      (#%python-code
        (define (tagger n)
          (define (inner x #:k k . rest) (list n x k rest))
          inner)
        (print ((tagger 1) 2 #:k 3 4 5))))
    (check-true (string-contains? code "apply(_lift"))
    (check-true (string-contains? code ", k=k)"))
    (check-equal? (python-output code) "[1, 2, 3, [4, 5]]\n"))

  (test-case "apply carries a keyword to the function it calls"
    (check-equal? (python-output
                   (#%python-code (print (apply (lambda (a b) (+ a b)) (list 1) #:b 2))))
                  "3\n"))

  (test-case "a keyword parameter is in scope, and may be set!"
    (define code
      (#%python-code
        (define (counter #:start start) (set! start (+ start 1)) start)
        (print (counter #:start 1))))
    (check-equal? code
                  (string-append "# generated by rkt-pythonize\n"
                                 "\n"
                                 "def counter(*, start):\n"
                                 "    start = (start + 1)\n"
                                 "    return start\n"
                                 "\n"
                                 "print(counter(start=1))\n"))
    (check-equal? (python-output code) "2\n"))

  (test-case "the Python name of a top-level name is what the conversion says"
    ;; a program that exports its names reads this: every top-level name of the
    ;; program is the Python name of the name the source wrote, and nothing else
    (check-equal? (#%python-code
                    (define (my-func? x) x)
                    (define x-y (my-func? 1)))
                  (string-append "# generated by rkt-pythonize\n"
                                 "\n"
                                 "def my_func_p(x):\n"
                                 "    return x\n"
                                 "\n"
                                 "x_y = my_func_p(1)\n"))
    (define code
      (#%python-code
        (define (set-car! xs v) (object-set! xs 0 v))
        (define (class x) x)
        (define 1st 1)
        (define list-of-names (list 1 2))))
    (check-true (string-contains? code "def set_car_b(xs, v):"))
    (check-true (string-contains? code "def class_(x):"))
    (check-true (string-contains? code "_1st = 1"))
    (check-true (string-contains? code "list_of_names = list(1, 2)")))

  (test-case "two top-level names that are one Python name are refused"
    ;; which way round the two are written does not matter: what is compared is
    ;; the Python name, so the scheme spelling and the Python one meet
    (check-regexp-match #rx"x-y and x_y are both x_y in Python"
                        (refusal-message '((define x-y 1) (define x_y 2))))
    (check-regexp-match #rx"x_y and x-y are both x_y in Python"
                        (refusal-message '((define x_y 1) (define x-y 2))))
    (check-regexp-match #rx"even\\? and even_p are both even_p in Python"
                        (refusal-message '((define (even? x) x) (define even_p 1))))
    (check-regexp-match #rx"even_p and even\\? are both even_p in Python"
                        (refusal-message '((define (even_p x) x) (define (even? x) x))))
    ;; and in camel, where the two spellings of objectRef meet too
    (check-regexp-match #rx"objectRef and object-ref are both objectRef in Python"
                        (refusal-message-in-style 'camel
                                                  '((define objectRef 1)
                                                    (define object-ref 2))))
    ;; the same name twice is the program's own business, as it is in Python
    (check-equal? (python-output
                   (#%python-code (define x 1) (define x 2) (print x)))
                  "2\n"))

  (test-case "the prelude's names carry a prefix, so a program cannot take them"
    ;; the pieces the compiler calls itself are the prefixed ones, whatever the
    ;; program calls its own names
    (define code
      (python-of-data-with-prefix
       "_pz_"
       '((define (_raise x) "the program's raise")
         (define (apply f xs) "the program's apply")
         (define (tagger n)
           (define (inner x . rest) (list n x rest))
           inner)
         (print (with-handler (lambda (e) (+ "caught " e)) (raise "boom")))
         (print ((tagger 1) 2 3)))))
    (check-true (string-contains? code "def _pz_raise_(value):"))
    (check-true (string-contains? code "class _pz_Raised(Exception):"))
    (check-true (string-contains? code "def _pz_apply(function, *arguments, **keywords):"))
    ;; and the program's own names stand beside them
    (check-true (string-contains? code "def _raise(x):"))
    (check-true (string-contains? code "def apply(f, xs):"))
    (check-equal? (python-output code) "caught boom\n[1, 2, [3]]\n")
    ;; a name the program defines is the program's own where it is bound, and
    ;; the prelude's piece is not carried for it at all
    (define shadowed
      (python-of-data-with-prefix
       "_pz_"
       '((define (list . items) items)
         (print (list 1 2)))))
    (check-true (string-contains? shadowed "def list(*items):"))
    (check-false (string-contains? shadowed "_pz_list")))

  (test-case "a name the compiler makes up is made of a UUID"
    (define code
      (#%python-code
        (define (adder n) (lambda (x) (+ x n)))
        (define _lift1 "the program's")
        (define add2 (adder 2))
        (print (add2 3))
        (print _lift1)))
    ;; the program keeps the name it wrote, and the lifted def has one of its own
    (check-true (regexp-match? #px"def _lift_[0-9a-f]{8}\\(n, x\\):" code))
    (check-true (string-contains? code "_lift1 = \"the program's\""))
    (check-equal? (python-output code) "5\nthe program's\n"))

  (test-case "the conversion is a parameter: camel names a program its own way"
    (define code
      (python-of-data-in-style 'camel
                               '((define (even? n) (= (modulo n 2) 0))
                                 (define my-name "camel")
                                 (define (set-car! xs v) (object-set! xs 0 v))
                                 (print (even? 4))
                                 (print my-name))))
    (check-true (string-contains? code "def isEven(n):"))
    (check-true (string-contains? code "myName = \"camel\""))
    (check-true (string-contains? code "def setCarB(xs, v):"))
    ;; the piece the call needs is named the same way as the call
    (check-true (string-contains? code "objectSetB(xs, 0, v)"))
    (check-true (string-contains? code "def objectSetB(obj, key, value):"))
    (check-equal? (python-output code) "True\ncamel\n")
    ;; a keyword argument's name is converted in the style of the moment too
    (define keyworded
      (python-of-data-in-style 'camel
                               '((define (f #:my-key my-key) my-key)
                                 (print (f #:my-key 2)))))
    (check-true (string-contains? keyworded "def f(*, myKey):"))
    (check-true (string-contains? keyworded "f(myKey=2)"))
    (check-equal? (python-output keyworded) "2\n"))

  (test-case "a local procedure is lifted, and may recurse"
    (check-equal? (python-output
                   (#%python-code
                     (define (sum-to n)
                       (define (loop i acc) (if (= i 0) acc (loop (- i 1) (+ acc i))))
                       (loop n 0))
                     (print (sum-to 4))))
                  "10\n"))

  (test-case "two local procedures may call each other"
    (check-equal? (python-output
                   (#%python-code
                     (define (parity n)
                       (define (ev? i) (if (= i 0) "even" (od? (- i 1))))
                       (define (od? i) (if (= i 0) "odd" (ev? (- i 1))))
                       (ev? n))
                     (print (parity 7))))
                  "odd\n"))

  (test-case "a lifted procedure cannot set! what it captures"
    (check-true (refuses? '((define (counter)
                              (define n 0)
                              (define (bump) (set! n (+ n 1)))
                              (bump)
                              n))))
    (check-true (refuses? '((define (outer a)
                              (define (f) a)
                              (lambda (a) (f)))))))

  (test-case "lambda is a value whose body is one expression"
    (check-equal? (python-output
                   (#%python-code
                     (define add1 (lambda (x) (+ x 1)))
                     (print (add1 2))
                     (print ((lambda (x y) (+ x y)) 3 4))
                     (print (apply (lambda (a b) (* a b)) (list 2 5)))))
                  "3\n7\n10\n")
    (check-true (refuses? '((lambda (x)))))
    (check-true (refuses? '((define (f))))))

  (test-case "the prelude is only what the program asked for"
    (define plain (#%python-code (print "hi")))
    (check-false (string-contains? plain "importlib"))
    (check-false (string-contains? plain "trampoline"))
    (check-false (string-contains? plain "with_handler"))
    (check-false (string-contains? plain "raise_"))
    (check-equal? (python-output plain) "hi\n")
    ;; with-handler catches Raised, so it has to bring raise along
    (define handled
      (#%python-code (print (with-handler (lambda (e) 0) (object-ref (list) 5)))))
    (check-true (string-contains? handled "Raised"))
    (check-false (string-contains? handled "trampoline"))
    (check-equal? (python-output handled) "0\n")
    ;; a trampoline program carries its piece and nothing else
    (define looping
      (#%python-code
        (define (count n) (if (= n 0) "done" (lambda () (count (- n 1)))))
        (print (trampoline (count 3)))))
    (check-true (string-contains? looping "trampoline"))
    (check-false (string-contains? looping "importlib"))
    (check-equal? (python-output looping) "done\n"))

  (test-case "operators are syntax, by arity"
    (check-equal? (python-output
                   (#%python-code
                     (print (+ 1 2 3))
                     (print (+ 1 2))
                     (print (+ 5))
                     (print (- 10 1 2))
                     (print (- 5))
                     (print (modulo 7 2))
                     (print (expt 2 3))
                     (print (& 12 10))
                     (print (\| 12 10))
                     (print (^ 12 10))
                     (print (~ 12))
                     (print (<< 1 4))
                     (print (>> 16 2))
                     (print (not= 1 2))
                     (print (= 1 1))
                     (print (in 2 (list 1 2 3)))
                     (print (not (in 5 (list 1 2 3))))))
                  "6\n3\n5\n7\n-5\n1\n8\n8\n14\n6\n-13\n16\n4\nTrue\nTrue\nTrue\nTrue\n")
    ;; with two or more operands + is infix, with one it is the operand itself
    (define code
      (#%python-code
        (print (+ 1 2))
        (print (+ 5))))
    (check-true (string-contains? code "print((1 + 2))"))
    (check-true (string-contains? code "print(5)"))
    (check-true (refuses? '((print +))))
    (check-true (refuses? '((& 1))))
    (check-true (refuses? '((not 1 2)))))

  (test-case "a name the program never defines is a warning, not an error"
    (check-true (string-contains? (warnings-of '((print nowhere))) "nowhere"))
    (check-true (string-contains? (warnings-of '((set! nowhere 1))) "nowhere"))
    (check-false (string-contains? (warnings-of '((define x 1) (print (+ x 1))))
                                   "warning"))
    (check-false (string-contains? (warnings-of '((print (len "abc")))) "warning"))
    (check-false (string-contains? (warnings-of '((print (object-ref (list 1 2) 0))))
                                   "warning"))
    (check-false (string-contains? (warnings-of '((define (f a . rest) (print rest)) (f 1 2)))
                                   "warning"))
    ;; a keyword parameter is a parameter like any other
