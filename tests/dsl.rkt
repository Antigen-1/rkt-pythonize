  (test-case "a begin where a value belongs is lifted into a procedure of its own"
    (define code
      (#%python-code
        (define (f x) (begin (print "a") (print "b") (+ x 1)))
        (define y (if (begin (print "t") #t) (begin (print "c") 1) 2))
        (define (g) (begin (define z 5)) (* z z))
        (print (f 1)) (print y) (print (g))))
    ;; a body's begin is its statements, and its last form is the value
    (check-true (string-contains?
                 code "def f(x):\n    print(\"a\")\n    print(\"b\")\n    return (x + 1)"))
    ;; a begin in a value's place is a def of its own, called where it stands
    (check-true (regexp-match?
                 #px"def _lift_[0-9a-f]{8}\\(\\):\n    print\\(\"t\"\\)\n    return True" code))
    (check-true (regexp-match?
                 #px"def _lift_[0-9a-f]{8}\\(\\):\n    print\\(\"c\"\\)\n    return 1" code))
    ;; a begin as a statement keeps its definitions where they mean something
    (check-true (string-contains? code "def g():\n    z = 5\n    return (z * z)"))
    (check-false (string-contains? code "begin("))
    (check-equal? (python-output code) "t\nc\na\nb\n2\n1\n25\n"))

  (test-case "a definition in a begin means something in a body and nothing in an expression"
    ;; a begin that stands as a statement has its definitions, and a body's last
