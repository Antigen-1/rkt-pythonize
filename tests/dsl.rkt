                 (python-of-data '((define (g) (begin (define z 5) (print z)) z)))
                 "def g():\n    z = 5\n    print(z)\n    return z"))
    ;; refused, and what it is refused with is what a begin means
    (check-equal? (refusal-message '((print (begin (define z 5) z))))
                  (string-append "check-expression: ?: a begin sequences expressions: "
                                 "a definition belongs in a body, where a name is defined: "
                                 "(define z 5)")))

  (test-case "None, True and False are values to read, not names to bind"
    (check-true (string-contains? (python-of-data '((print None))) "print(None)"))
    (check-true (refuses? '((define None 1))))
    (check-true (refuses? '((define (f True) 1))))
    (check-true (refuses? '((set! False 1)))))
  (test-case "-> threads into the first position and ->> into the last"
    (define code
      (#%python-code
        (define (add1 x) (+ x 1))
        (print (-> 3 (+ 4) (- 1)))
        (print (->> 3 (- 10) (* 2)))
        (print (-> 3 add1))
        (print (->> (list 1 2) (sorted #:reverse #t)))))
    ;; a chain is run by the trampoline, and a begin is nowhere in it
    (check-true (string-contains? code "trampoline("))
    (check-false (string-contains? code "begin("))
    (check-equal? (python-output code) "6\n14\n4\n[2, 1]\n"))

  (test-case "an exception stops the chain, and nothing else does"
    (define code
      (#%python-code
        (define (half x) (if (= x 0) (Exception "zero") (quotient x 2)))
        (define (inc x) (print "inc") (+ x 1))
        (print (-> 8 half inc))
        ;; an Exception, or a subclass of it, is the chain's value, and the steps
        ;; after it do not run
        (print (-> 0 half inc))
        ;; None is a value like any other now
        (print (-> None (list)))
        ;; the value of the last step is handed back even when it is callable
        (print ((-> 5 (object-get-attr "bit_length"))))))
    (check-equal? (python-output code) "inc\n5\nzero\n[None]\n3\n"))

  (test-case "a threading form needs a value and steps that are calls or names"
    (check-true (refuses? '((->))))
    (check-true (refuses? '((-> 1 2))))
    (check-true (refuses? '((-> 1 (quote x)))))
    ;; a value and no steps is the value
    (check-true (string-contains? (python-of-data '((print (-> 7)))) "print(7)\n"))

  (test-case "a chain is flat however many steps it has"
    ;; more steps than Python's own recursion limit: the trampoline is what
    ;; keeps this from nesting a call per step
    (define steps 1200)
    (define code
      (python-of-data-with
       (list `(defmacro (many x)
                ;; one chain of many steps, not a chain of chains
                (let loop ([n ,steps] [seen '()])
                  (if (= n 0)
                      `(-> ,x ,@(reverse seen))
                      (loop (sub1 n) (cons '(add1) seen))))))
       '((define (add1 x) (+ x 1))
         (print (many 0)))))
    (check-equal? (python-output code) (format "~a\n" steps))))
)
