#lang racket/base

;; The build's virtual environment.  Each project has one, under the directory
;; the build writes, and the build installs the project's Python dependencies
;; and PyInstaller into it.  Nothing is shared between projects: the build
;; starts with nothing but python and its venv module, and pip's cache is what
;; keeps a second project from downloading the same packages again.
;;
;; A stamp in the venv says what it was made from.  A build whose declaration
;; matches the stamp installs no requirements; one whose does not runs pip.

(require racket/file
         racket/path
         racket/port
         racket/string
         racket/system
         "project.rkt")

(provide python-executable
         venv-python-path
         ensure-venv
         prepare-venv
         install-requirements
         requirements-text
         venv-stamp
         stamp-path
         venv-hidden-imports)

(define (windows?) (eq? (system-type 'os) 'windows))

(define (venv-python-path directory)
  (build-path directory
              (if (windows?) "Scripts" "bin")
              (if (windows?) "python.exe" "python")))

;; the interpreter #:python names, absolute, or #f
(define (python-executable name)
  (or (find-executable-path name)
      (and (file-exists? name) (path->complete-path name))))

(define (command-output command . arguments)
  (define output (open-output-string))
  (define ok
    (parameterize ([current-output-port output]
                   [current-error-port (open-output-nowhere)])
      (apply system* command arguments)))
  (values ok (string-trim (get-output-string output))))

;; the venv's python, made if it is not there yet
(define (ensure-venv directory #:python [python "python3"] #:quiet? [quiet? #f])
  (define directory* (simplify-path (path->complete-path directory)))
  (define python* (python-executable python))
  (unless python*
    (error 'build-executable
           "~a is not an executable: #:python names the interpreter that makes the venv"
           python))
  (define venv-python (venv-python-path directory*))
  (cond [(file-exists? venv-python) venv-python]
        [else
         (unless quiet?
           (printf "build: making the venv in ~a\n" (path->string directory*)))
         (make-directory* directory*)
         (unless (system* python* "-m" "venv" (path->string directory*))
           (error 'build-executable
                  "~a -m venv ~a failed: is the venv module installed?"
                  (path->string python*)
                  (path->string directory*)))
         (unless (file-exists? venv-python)
           (error 'build-executable "~a: the venv has no python"
                  (path->string directory*)))
         venv-python]))

;; ---- what the venv was made from

(define stamp-name ".rkt-pythonize-venv")

(define (stamp-path venv-directory)
  (build-path venv-directory stamp-name))

;; the requirements as one text: the file pip reads, then the strings the
;; build was given, one a line
(define (requirements-text requirements)
  (define path (requirements-path requirements))
  (define file-text (if path (file->string path) ""))
  (define entry-text (string-join (requirements-entries requirements) "\n"))
  (string-append
   file-text
   (if (and (positive? (string-length file-text))
            (not (char=? #\newline
                         (string-ref file-text (sub1 (string-length file-text))))))
       "\n"
       "")
   entry-text
   (if (positive? (string-length entry-text)) "\n" "")))

(define (venv-stamp python requirements pyinstaller)
  (string-append
   "# generated by rkt-pythonize: the dependencies this venv has\n"
   "python: " (path->string python) "\n"
   "pyinstaller: " (or pyinstaller "any") "\n"
   "requirements:\n"
   (requirements-text requirements)))

(define (stamp-current? venv-directory stamp)
  (define path (stamp-path venv-directory))
  (and (file-exists? path)
       (equal? (file->string path) stamp)))

(define (write-stamp! venv-directory stamp)
  (display-to-file stamp (stamp-path venv-directory) #:exists 'replace))

;; ---- installing the build dependencies

;; the requirements file and the requirement strings, installed together so a
;; file that names another file with -r still resolves it from the project
(define (install-requirements venv-python requirements
                              #:working-directory [working-directory (current-directory)]
                              #:quiet? [quiet? #f])
  (define path (requirements-path requirements))
  (define entries (requirements-entries requirements))
  (unless (and (not path) (null? entries))
    (unless quiet?
      (printf "build: installing the Python dependencies in ~a\n"
              (path->string venv-python)))
    (define arguments
      (append (list "-m" "pip" "install" "--disable-pip-version-check" "--no-input")
              (if quiet? (list "-q") '())
              (if path (list "-r" (path->string path)) '())
              entries))
    (unless (parameterize ([current-directory working-directory])
              (apply system* venv-python arguments))
      (error 'build-executable
             "installing the Python dependencies in ~a failed"
             (path->string venv-python)))))

;; pyinstaller, installed into the project's venv at the version the build
;; asks for
(define (ensure-pyinstaller venv-python version #:quiet? [quiet? #f])
  (define installed (pyinstaller-version venv-python))
  (define wanted (and version (format "pyinstaller==~a" version)))
  (cond [(and version (equal? installed version)) venv-python]
        [(and (not version) installed) venv-python]
        [else
         (unless quiet?
           (printf "build: installing ~a in ~a\n"
                   (or wanted "pyinstaller")
                   (path->string venv-python)))
         (define arguments
           (append (list "-m" "pip" "install" "--disable-pip-version-check" "--no-input")
                   (if quiet? (list "-q") '())
                   (list (or wanted "pyinstaller"))))
         (unless (apply system* venv-python arguments)
           (error 'build-executable "installing pyinstaller in ~a failed"
                  (path->string venv-python)))
         venv-python]))

(define (pyinstaller-version venv-python)
  (define-values (ok output)
    (command-output venv-python "-c" "import PyInstaller; print(PyInstaller.__version__)"))
  (and ok output))

;; PyInstaller cannot see (import x), which is a dynamic import, so the build
;; names the project's Python dependencies to it too.  A distribution says what
;; its top-level modules are in top_level.txt, which pip writes; one without it
;; is read from the files it installed.  PyInstaller itself is not part of the
;; program.
(define top-level-modules-code
  (string-append
   "import importlib.metadata as metadata\n"
   "import importlib.util\n"
   "\n"
   "excluded = {\n"
   "    'pip', 'setuptools', 'wheel',\n"
   "    'pyinstaller', 'pyinstaller-hooks-contrib',\n"
   "    'altgraph', 'macholib', 'pefile', 'pywin32-ctypes',\n"
   "}\n"
   "\n"
   "def usable(module):\n"
   "    try:\n"
   "        return importlib.util.find_spec(module) is not None\n"
   "    except Exception:\n"
   "        return False\n"
   "\n"
   "names = set()\n"
   "for dist in metadata.distributions():\n"
   "    name = (dist.metadata.get('Name') or '').strip().lower()\n"
   "    if not name or name in excluded:\n"
   "        continue\n"
   "    try:\n"
   "        top = dist.read_text('top_level.txt')\n"
   "    except Exception:\n"
   "        top = None\n"
   "    if top and top.strip():\n"
   "        names.update(line.strip() for line in top.splitlines() if line.strip())\n"
   "        continue\n"
   "    for file in (dist.files or ()):\n"
   "        parts = file.parts\n"
   "        if not parts:\n"
   "            continue\n"
   "        first = parts[0]\n"
   "        if first.endswith('.dist-info') or first.endswith('.data'):\n"
   "            continue\n"
   "        if first in ('bin', 'Scripts', 'include', 'share', 'etc', '..', '__pycache__'):\n"
   "            continue\n"
   "        if len(parts) == 1 and first.endswith('.py'):\n"
   "            names.add(first[:-3])\n"
   "        elif len(parts) > 1:\n"
   "            names.add(first)\n"
   "print('\\n'.join(sorted(name for name in names if usable(name))))\n"))

;; the modules of the venv's distributions, for the build to name to PyInstaller
(define (venv-hidden-imports venv-python)
  (define-values (ok output)
    (command-output venv-python "-c" top-level-modules-code))
  (unless ok
    (error 'build-executable
           "reading the Python packages installed in ~a failed"
           (path->string venv-python)))
  (filter (lambda (line) (not (string=? line "")))
          (map string-trim (string-split output "\n"))))

;; the project's venv, with its dependencies and pyinstaller installed: the
;; venv is made if it is not there, the requirements are installed when the
;; stamp says the declaration changed, and pyinstaller is checked every time
;; because a venv can be changed behind the build's back
(define (prepare-venv venv-directory requirements
                      #:python [python "python3"]
                      #:pyinstaller [pyinstaller "6.22.3"]
                      #:working-directory [working-directory (current-directory)]
                      #:quiet? [quiet? #f])
  (define python* (python-executable python))
  (unless python*
    (error 'build-executable
           "~a is not an executable: #:python names the interpreter that makes the venv"
           python))
  (define venv-python (ensure-venv venv-directory #:python python* #:quiet? quiet?))
  (define directory (simplify-path (path->complete-path venv-directory)))
  (define stamp (venv-stamp python* requirements pyinstaller))
  (define current? (stamp-current? directory stamp))
  (unless current?
    (install-requirements venv-python requirements
                          #:working-directory working-directory
                          #:quiet? quiet?))
  (ensure-pyinstaller venv-python pyinstaller #:quiet? quiet?)
  (unless current?
    (write-stamp! directory stamp))
  venv-python)
