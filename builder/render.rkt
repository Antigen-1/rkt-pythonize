#lang racket/base

;; The second stage: the program as Python.  Every .rkt of the source
;; directory is compiled to the Python it renders and written as .py under
;; build/python, every .py is copied as it is, and a directory that is a
;; package gets an empty __init__.py if the program did not write one.

(require racket/file
         racket/list
         racket/path
         racket/string
         "project.rkt")

(provide render-project)

(define (render-project project #:quiet? [quiet? #f])
  (define python-directory (project-python-directory project))
  (when (directory-exists? python-directory)
    (delete-directory/files python-directory))
  (make-directory* python-directory)
  ;; one namespace for the program: the compiler's names are made once per
  ;; namespace, so the modules of one program agree about them
  (define namespace (make-base-namespace))
  (for ([file (in-list (project-files project))])
    (define output (project-output-file project file))
    (make-directory* (path-only output))
    (case (source-file-kind file)
      [(python)
       (copy-file (source-file-path file) output #t)]
      [(racket)
       (display-to-file (python-of-file file namespace) output #:exists 'replace)]
      [else
       (error 'build-executable "~a: unknown source kind ~a"
              (path->string (source-file-path file))
              (source-file-kind file))])
    (unless quiet?
      (printf "build: ~a -> ~a\n"
              (path->string (source-file-path file))
              (path->string output))))
  (write-initialisers python-directory)
  (write-runtime-module python-directory)
  (write-attachments project #:quiet? quiet?)
  (project-modules project))

;; a program finds what was attached to it through this module: PyInstaller
;; unpacks the attachments under sys._MEIPASS, and a program run from
;; build/python finds them in build/, so the module looks at both
(define runtime-module-python
  (string-append
   "# generated by rkt-pythonize\n"
   "\"\"\"The attachments of this program, and where they are.\n"
   "\n"
   "The build packs a data/ directory and whatever #:data named under this\n"
   "module, or under the directory the program was unpacked into.\n"
   "\"\"\"\n"
   "\n"
   "import os\n"
   "import sys\n"
   "\n"
   "\n"
   "def base(*parts):\n"
   "    \"\"\"The directory the attachments are under, then parts under it.\"\"\"\n"
   "    root = getattr(sys, \"_MEIPASS\", None)\n"
   "    if root is None:\n"
   "        root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n"
   "    if not parts:\n"
   "        return root\n"
   "    return os.path.join(root, *parts)\n"
   "\n"
   "\n"
   "def path(*parts):\n"
   "    \"\"\"The path of an attachment: path('data', 'hello.txt').\"\"\"\n"
   "    return base(*parts)\n"
   "\n"
   "\n"
   "def read(*parts):\n"
   "    \"\"\"The bytes of an attachment.\"\"\"\n"
   "    with open(path(*parts), 'rb') as stream:\n"
   "        return stream.read()\n"
   "\n"
   "\n"
   "def text(*parts):\n"
   "    \"\"\"An attachment's text, as UTF-8.\"\"\"\n"
   "    with open(path(*parts), 'r', encoding='utf-8') as stream:\n"
   "        return stream.read()\n"))

(define (write-runtime-module python-directory)
  (display-to-file runtime-module-python
                   (build-path python-directory (string-append runtime-module ".py"))
                   #:exists 'replace))

;; the attachments are written under build/ as well, so the program runs from
;; build/python with them before it is packed; the build writes one attachment
;; at a time, replacing what was there
(define (write-attachments project #:quiet? [quiet? #f])
  (define root (project-dest project))
  (for ([attachment (in-list (project-attachments project))])
    (define source (attachment-source attachment))
    (define dest (attachment-dest attachment))
    (define target (if (equal? dest ".") root (build-path root (string->path dest))))
    (cond [(directory-exists? source)
           (delete-if-exists target)
           (copy-tree source target)]
          [else
           (define file (build-path target (file-name-from-path source)))
           (delete-if-exists file)
           (make-directory* (path-only file))
           (copy-file source file #t)])
    (unless quiet?
      (printf "build: ~a -> ~a\n" (path->string source) (path->string target)))))

(define (copy-tree source target)
  (make-directory* target)
  (for ([element (in-list (sort (directory-list source) string<? #:key path->string))])
    (define from (build-path source element))
    (define to (build-path target element))
    (if (directory-exists? from)
        (copy-tree from to)
        (copy-file from to #t))))

(define (delete-if-exists path)
  (cond [(directory-exists? path) (delete-directory/files path)]
        [(file-exists? path) (delete-file path)]))

;; the Python a .rkt module renders: the value of its python, which
;; #%python-code makes a string
(define (python-of-file file namespace)
  (define path (source-file-path file))
  (define python
    (parameterize ([current-namespace namespace]
                   ;; a build neither reads nor writes the compiled files
                   ;; Racket would otherwise leave beside the sources
                   [use-compiled-file-paths '()])
      (dynamic-require (list 'file (path->string path)) 'python (lambda () #f))))
  (cond [(not python)
         (error 'build-executable
                "~a: every .rkt of the program provides python, the Python it renders"
                (path->string path))]
        [(not (string? python))
         (error 'build-executable
                "~a: python is ~s, not the string it renders"
                (path->string path)
                python)]
        [else python]))

;; a package is a directory with an __init__.py; one the program did not
;; write itself is empty
(define (write-initialisers root)
  (for ([dir (in-list (directories root))] #:unless (equal? dir root))
    (define init (build-path dir "__init__.py"))
    (unless (file-exists? init)
      (display-to-file "" init #:exists 'replace))))

(define (directories root)
  (sort (walk-directories root) string<? #:key path->string))

(define (walk-directories dir)
  (append*
   (cons (list dir)
         (for/list ([element (in-list (sort (with-handlers ([exn:fail? (lambda (e) '())])
                                              (directory-list dir))
                                          string<? #:key path->string))])
           (define path (build-path dir element))
           (if (directory-exists? path) (walk-directories path) '())))))
